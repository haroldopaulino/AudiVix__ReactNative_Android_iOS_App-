{
  "name": "AudiVix",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "pods": "cd ios && bundle exec pod install",
    "check:android": "node scripts/check-android-config.js",
    "postinstall": "node scripts/align-gradle-versions.js && node scripts/patch-rn-agp9-library.js && node scripts/patch-track-player.js && node scripts/patch-third-party-warnings.js",
    "build:android:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.0.1",
    "@react-native/new-app-screen": "0.82.1",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-track-player": "^4.1.2",
    "react-native-video": "^6.17.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-fs": "^2.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "author": "Haroldo Paulino"
}
